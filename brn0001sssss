import asyncio
import json
import websockets

ORDENS_ATIVAS = []
CLIENTES_CONECTADOS = set()

async def broadcast_ordens():
    """Transmite ordens atualizadas para todas as carteiras conectadas"""
    if CLIENTES_CONECTADOS:
        mensagem = json.dumps({"type": "SYNC_ORDERS", "data": ORDENS_ATIVAS})
        await asyncio.gather(*[cliente.send(mensagem) for cliente in CLIENTES_CONECTADOS])

async def gerenciar_websocket(websocket):
    CLIENTES_CONECTADOS.add(websocket)
    print(f"[+] Carteira BRN conectada. Total ativas: {len(CLIENTES_CONECTADOS)}")

    try:
        # Envia as ordens atuais ao se conectar
        await websocket.send(json.dumps({"type": "SYNC_ORDERS", "data": ORDENS_ATIVAS}))

        async for message in websocket:
            dados = json.loads(message)
            
            if dados.get("type") == "NEW_ORDER":
                payload = dados.get("payload")
                nova_ordem = {
                    "id": payload["ordemData"]["nonce"],
                    "ordemData": payload["ordemData"],
                    "assinatura": payload["assinatura"],
                    "chavePix": payload["chavePix"],
                    "status": "ATIVA"
                }
                ORDENS_ATIVAS.append(nova_ordem)
                print(f"[+] Nova ordem recebida: {payload['ordemData']['valorUSDC']} USDC")
                await broadcast_ordens()

            elif dados.get("type") == "CANCEL_ORDER":
                nonce_cancelar = dados.get("nonce")
                global ORDENS_ATIVAS
                ORDENS_ATIVAS = [o for o in ORDENS_ATIVAS if o["id"] != nonce_cancelar]
                print(f"[-] Ordem {nonce_cancelar} removida do mural.")
                await broadcast_ordens()

    except websockets.exceptions.ConnectionClosedError:
        pass
    finally:
        CLIENTES_CONECTADOS.remove(websocket)
        print(f"[-] Carteira desconectada. Restantes: {len(CLIENTES_CONECTADOS)}")

async def main():
    print("==================================================")
    print(" Servidor de Sincronizacao BRN P2P (Python) ")
    print(" Executando em: ws://localhost:3000")
    print("==================================================")
    async with websockets.serve(gerenciar_websocket, "0.0.0.0", 3000):
        await asyncio.Future()

if __name__ == "__main__":
    asyncio.run(main())
