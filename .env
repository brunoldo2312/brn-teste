# ============================================================
# BRN-Estavel — Variáveis de ambiente
# Copie para ".env" e preencha. NUNCA comite o ".env".
# ============================================================

# --- ngrok ---
NGROK_AUTHTOKEN=
BRN_USE_NGROK=1

# --- SEGURANÇA (obrigatórias) ---
# Senha mestra para cifrar chaves dos nós/faucet (mín. 20 chars)
BRN_MASTER_PASSWORD=
# Credenciais do dashboard (mín. 16 chars na senha)
BRN_WEB_USER=admin
BRN_WEB_PASS=

# --- Rede ---
BRN_NETWORK_ID=brn-mainnet-1
BRN_P2P_HOST=0.0.0.0
BRN_P2P_PORT=7777
BRN_SEED_PEERS=

# --- Web ---
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_PORT=8080

# --- Persistência ---
BRN_DB_PATH=blockchain.db
BRN_DB=blockchain.db
BRN_IDENTITY_FILE=node_identity.wallet
BRN_FAUCET_KEY_FILE=faucet_identity.wallet

# --- Consenso ---
BRN_TARGET_BLOCK_TIME=10
BRN_BLOCK_REWARD=50
BRN_MIN_STAKE=100
BRN_FINALITY_INTERVAL=5
BRN_FINALITY_THRESHOLD=0.67

# --- Faucet ---
BRN_FAUCET_ADDRESS=
BRN_FAUCET_AMOUNT=100
BRN_FAUCET_COOLDOWN=3600
BRN_FAUCET_MAX_PER_IP=3

# --- Alocações iniciais ---
BRN_GENESIS_ALLOC=

# --- Relatório do explorer ---
BRN_REPORT_INTERVAL=30